<?xml version="1.0"?>
<launch>
  <arg name="rviz" default="false" />
  <arg name="save_dir" default="$(env HOME)/ocl3d_imf_workdir/iusl_bag_2023_04_25" />
  <arg name="load_weights" default="false" />
  <arg name="model_file_name" default="" />
  <arg name="fallback_label" default="" />
  <arg name="use_camera" default="true" />
  <arg name="use_yolo" default="true" />
  <arg name="yolo_image_topic" default="/hikrobot_camera/rgb/compressed" />
  <arg name="yolo_model" default="yolov8n.pt" />
  <arg name="yolo_confidence" default="0.25" />
  <arg name="yolo_iou" default="0.45" />
  <arg name="cyclist_iou" default="0.4" />
  <arg name="yolo_device" default="" />
  <arg name="tracking_frame" default="velodyne" />
  <arg name="person_unknown_only" default="true" />
  <arg name="replay_buffer_size_per_class" default="512" />
  <arg name="replay_samples_per_class" default="2" />
  <arg name="initial_samples_file" default="$(find online_forests_ros)/data/initial_samples_iusl_bag_2023_04_25.jsonl" />
  <arg name="initial_train_epochs" default="1" />

  <rosparam file="$(find autoware_tracker)/config/params_iusl_bag_2023_04_25.yaml" command="load" subst_value="true" />
  <param name="autoware_tracker/cluster/use_camera" type="bool" value="$(arg use_camera)" />
  <param name="autoware_tracker/tracker/tracking_frame" type="string" value="$(arg tracking_frame)" />

  <node if="$(arg use_yolo)" pkg="kitti_camera_ros" type="yolov8_camera_ros" name="yolov8_camera_ros" output="screen">
    <param name="image_topic" type="string" value="$(arg yolo_image_topic)" />
    <param name="model" type="string" value="$(arg yolo_model)" />
    <param name="confidence" type="double" value="$(arg yolo_confidence)" />
    <param name="iou" type="double" value="$(arg yolo_iou)" />
    <param name="cyclist_iou" type="double" value="$(arg cyclist_iou)" />
    <param name="device" type="string" value="$(arg yolo_device)" />
    <param name="person_unknown_only" type="bool" value="$(arg person_unknown_only)" />
  </node>

  <node pkg="autoware_tracker" type="lidar_euclidean_cluster_detect" name="lidar_euclidean_cluster_detect" output="screen" />
  <node pkg="autoware_tracker" type="imm_ukf_pda" name="imm_ukf_pda" output="screen" />
  <param name="autoware_tracker/tracker/is_benchmark" type="bool" value="false"/>
  <node pkg="autoware_tracker" type="visualize_detected_objects" name="ukf_track_visualization" output="screen" />

  <node pkg="point_cloud_features" type="point_cloud_features" name="point_cloud_features" output="screen" respawn="false">
    <param name="minimum_points" type="int" value="5"/>
    <param name="number_of_points" type="bool" value="true"/>
    <param name="min_distance" type="bool" value="true"/>
    <param name="covariance_mat3D" type="bool" value="true"/>
    <param name="normalized_MOIT" type="bool" value="true"/>
    <param name="slice_feature" type="bool" value="true"/>
    <param name="intensity_distribution" type="bool" value="true"/>
  </node>

  <node pkg="point_cloud_features" type="point_cloud_features_global" name="point_cloud_features_global" output="screen" respawn="false">
    <param name="include_unknown_labels" type="bool" value="true"/>
  </node>

  <include file="$(find online_forests_ros)/launch/online_forests_ros.launch">
    <arg name="kitti" value="false"/>
    <arg name="scence" value="2023-04-25-16-37-35"/>
    <arg name="noise" value="bag"/>
    <arg name="save_dir" value="$(arg save_dir)"/>
    <arg name="load_weights" value="$(arg load_weights)"/>
    <arg name="model_file_name" value="$(arg model_file_name)"/>
    <arg name="fallback_label" value="$(arg fallback_label)"/>
    <arg name="replay_buffer_size_per_class" value="$(arg replay_buffer_size_per_class)"/>
    <arg name="replay_samples_per_class" value="$(arg replay_samples_per_class)"/>
    <arg name="initial_samples_file" value="$(arg initial_samples_file)"/>
    <arg name="initial_train_epochs" value="$(arg initial_train_epochs)"/>
  </include>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find autoware_tracker)/../launch/efficient_online_learning.rviz" />
</launch>
